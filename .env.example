# Testkart Intelligence - Environment Configuration Template
# Strictly Local Development Mode - External Services & Live Publishing Disabled

# Project Owner & Administrative Contact
TESTKART_OWNER_EMAIL=meettomar07@gmail.com

# Publishing Gate (MUST remain False during local development)
TESTKART_ALLOW_LIVE_PUBLISHING=False

# Notification & Email Settings (STRICTLY disabled - no external SMTP connection)
TESTKART_ENABLE_EMAIL_NOTIFICATIONS=False
TESTKART_SMTP_HOST=
TESTKART_SMTP_PORT=587

# Server Binding (Bound strictly to localhost)
TESTKART_SERVER_HOST=127.0.0.1
TESTKART_SERVER_PORT=8000

# Security & Tokens
TESTKART_REQUIRE_CONTENT_HASH_VERIFICATION=True
TESTKART_APPROVAL_TOKEN_EXPIRY_HOURS=48

# Scheduling & Crawler
TESTKART_TIMEZONE=Asia/Kolkata
TESTKART_REQUEST_TIMEOUT_SECONDS=25.0
TESTKART_MAX_RETRIES=3

# AI Provider (deterministic / mock / gemini)
TESTKART_AI_PROVIDER=deterministic
TESTKART_GEMINI_API_KEY=
